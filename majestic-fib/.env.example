# ============================================
# ИНСТРУКЦИЯ ПО НАСТРОЙКЕ ПЕРЕМЕННЫХ ОКРУЖЕНИЯ
# ============================================
# 
# ВСЕ эти переменные нужно добавить в Vercel:
# Settings → Environment Variables
#
# НЕ ЗАПОЛНЯЙТЕ этот файл реальными данными!
# Он только для примера.

# Discord Application (публичные)
NEXT_PUBLIC_DISCORD_CLIENT_ID=1234567890123456789
NEXT_PUBLIC_DISCORD_REDIRECT_URI=https://your-app.vercel.app/api/auth

# Discord Application (секретные)
DISCORD_CLIENT_ID=1234567890123456789
DISCORD_CLIENT_SECRET=your_secret_here
DISCORD_REDIRECT_URI=https://your-app.vercel.app/api/auth

# JWT Secret
JWT_SECRET=generate_random_string_at_least_32_characters

# Discord Webhooks
WEBHOOK_PROMOTION=https://discord.com/api/webhooks/...
WEBHOOK_TRANSFER=https://discord.com/api/webhooks/...
WEBHOOK_REPORT=https://discord.com/api/webhooks/...
